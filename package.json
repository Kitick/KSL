{
	"name": "ksl",
	"version": "0.5.2",
	"description": "Kitick's Standard Library",
	"license": "ISC",
	"author": "Kevin Munson",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/Kitick/KSL.git"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		"./math": {
			"import": "./dist/math/index.js",
			"types": "./dist/math/index.d.ts"
		},
		"./structures": {
			"import": "./dist/structures/index.js",
			"types": "./dist/structures/index.d.ts"
		},
		"./utilities": {
			"import": "./dist/utilities/index.js",
			"types": "./dist/utilities/index.d.ts"
		}
	},
	"scripts": {
		"prepare": "tsc",
		"build": "esbuild test/index.ts --bundle --format=cjs --platform=browser --outfile=test/index.js",
		"test": "npm run build && node test/index.js"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "^0.25.4",
		"ts-brand": "^0.2.0",
		"typescript": "^5.8.3"
	}
}
